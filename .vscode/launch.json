{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web: Dev Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/web",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:.*(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Web: Debug in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/web/src",
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      },
      "preLaunchTask": "web-dev-server"
    },
    {
      "name": "Web: Debug Server (server.ts)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/web/node_modules/.bin/tsx",
      "args": ["server.ts"],
      "cwd": "${workspaceFolder}/web",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PORT": "8080"
      }
    }
  ]
}
