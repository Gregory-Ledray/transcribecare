{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "web-dev-server",
      "type": "npm",
      "script": "dev",
      "path": "web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:.*http"
        }
      }
    },
    {
      "label": "web-build",
      "type": "npm",
      "script": "build",
      "path": "web",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "web-lint",
      "type": "npm",
      "script": "lint",
      "path": "web",
      "group": "test",
      "problemMatcher": "$tsc"
    }
  ]
}
