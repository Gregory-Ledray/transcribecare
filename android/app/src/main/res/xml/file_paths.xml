<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- External files directory: getExternalFilesDir("recordings") -->
    <external-files-path
        name="recordings_external"
        path="recordings/" />

    <!-- Internal files directory fallback: filesDir/recordings -->
    <files-path
        name="recordings_internal"
        path="recordings/" />

    <!-- Cache directory for temporary share files (transcripts) -->
    <cache-path
        name="shared_transcripts"
        path="shared_transcripts/" />
</paths>
